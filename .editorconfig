root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{html,css,scss,js,json,yml,yaml,md,xml,svg}]
indent_size = 2

[*.rb]
indent_size = 2

[{Gemfile,Gemfile.lock,Rakefile}]
indent_size = 2

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
